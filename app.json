{
  "expo": {
    "name": "Noosh",
    "slug": "noosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#EBF5FF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abyar.water"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      },
      "package": "com.abyar.water",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.0.21",
            "extraGradleProperties": [
              {
                "propertyName": "android.useAndroidX",
                "propertyValue": "true"
              },
              {
                "propertyName": "android.enableJetifier",
                "propertyValue": "true"
              }
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D9CFF",
          "sounds": ["./assets/sounds/reminder.wav"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "448d9cd9-a38c-4c95-9852-d62b9b1a04df"
      }
    }
  }
}
