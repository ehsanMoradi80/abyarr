<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_streak_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/notification_icon"
        android:tint="#EA580C"
        android:contentDescription="@string/widget_streak_desc" />

    <TextView
        android:id="@+id/widget_streak_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="۵ روز متوالی"
        android:textColor="#C2410C"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_streak_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="زنجیره سلامتی روشن است"
        android:textColor="#64748B"
        android:textSize="11sp" />

</LinearLayout>
