# ====================================================================
# Abyar (آب‌یار) Environment Configuration (.env.example)
# Backend: Supabase (PostgreSQL, Auth, Storage & Realtime)
# ====================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=3000

# --------------------------------------------------------------------
# 1. Supabase Backend Configuration (بک‌اند سوپابیس)
# --------------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (کلید عمومی ناشناس)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Secret Key (کلید دسترسی مدیریتی سمت سرور)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Client-side Supabase Configuration (for Realtime & browser features)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Direct PostgreSQL Connection URL (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --------------------------------------------------------------------
# 2. Authentication & Sessions (نشست‌ها)
# --------------------------------------------------------------------
SESSION_SECRET=your_super_secret_session_key_min_32_characters
JWT_SECRET=your_jwt_signing_secret_key

# Clerk Authentication (کلرک)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --------------------------------------------------------------------
# 3. Iranian / Global SMS OTP Providers (ارسال پیامک کد ورود)
# --------------------------------------------------------------------
# Kavenegar SMS Service (کاوه نگار)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=1000...

# Ghasedak SMS Service (قاصدک)
GHASEDAK_API_KEY=

# SMS.ir Service (اس ام اس دات آی آر)
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=

# Twilio SMS (Global Fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --------------------------------------------------------------------
# 4. Push Notifications & Reminders (ارسال وب‌پوش و نوتیفیکیشن)
# --------------------------------------------------------------------
# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@abyar.app

# --------------------------------------------------------------------
# 5. AI Assistant & Insights (هوش مصنوعی جمینای برای توصیه‌ها)
# --------------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=

# Google Analytics 4 Measurement ID for web
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Add these files at the project root for native Android/iOS analytics:
# google-services.json
# GoogleService-Info.plist

# --------------------------------------------------------------------
# 6. CORS & App URL
# --------------------------------------------------------------------
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
